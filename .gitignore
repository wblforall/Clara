# Environment & secrets
.env
.env.*

# Runtime / temp
tmp/
*.log

# Dump database & backup (JANGAN pernah di-commit — berisi data customer)
*.sql
*.sql.gz
*.bak

# Artefak handout (besar / hasil generate) — markdown sumber tetap di-commit
HANDOUT_SALES.html
HANDOUT_SALES.pdf
scripts/handout_assets/

# Aset screenshot user guide (besar / hasil generate via scripts/userguide_screenshot.js)
# Source guide (docs/PANDUAN_*.md) & script TETAP di-commit; PNG di-regenerate.
scripts/userguide_assets/

# File kerja lokal (PDF/dokumen contoh, dll)
*.doc
*.docx
*.xlsx
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Testing dependencies
testing/node_modules/

# Unggahan klien (KTP / NPWP / SIUP / bukti transfer / scan surat ber-TTD).
# Repo ini PUBLIK — berkas ini tidak boleh ikut ter-commit.
public/uploads/*
!public/uploads/.htaccess
!public/uploads/.mpdf
public/uploads/.mpdf/*
!public/uploads/.mpdf/.gitignore
!public/uploads/.mpdf/.gitkeep
public/report_recurring.pdf

# Laporan jadi + aset screenshot: memuat nama & dokumen klien nyata.
# Sumber pembangunnya (scripts/build_*.php) boleh di-commit, hasilnya tidak.
docs/*.pdf
docs/*_assets/
/Laporan_*.pdf
/Laporan_*/
/Perbaikan_*/
/Rekonsiliasi_*/
/Audit_*/
/Panduan_*/
*.numbers
